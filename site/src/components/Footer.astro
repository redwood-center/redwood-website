---
const programs = [
  ['Helen Wills Neuroscience Institute', 'https://neurograd.berkeley.edu'],
  ['Vision Science', 'http://vision.berkeley.edu/'],
  ['Physics', 'http://physics.berkeley.edu/i-am-a-uc-berkeley/prospective-students/graduate-admissions'],
  ['EECS', 'https://eecs.berkeley.edu/academics/graduate'],
  ['Bioengineering', 'http://bioegrad.berkeley.edu/'],
  ['Biophysics', 'http://biophysics.berkeley.edu/admissions/'],
  ['Statistics', 'https://statistics.berkeley.edu/programs/graduate/phd'],
  ['Mathematics', 'https://math.berkeley.edu/programs/graduate/phd-program'],
];
---

<footer class="site-footer">
  <div class="wrap grid">
    <div class="involved">
      <h2>Get involved</h2>
      <p>
        Join us for a seminar or a journal club meeting, or reach out to one of our members directly.
        Prospective PhD students apply through one of Berkeley's graduate programs:
      </p>
      <ul class="programs">
        {programs.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </div>
    <div class="contact">
      <h2>Visit</h2>
      <address>
        Redwood Center for Theoretical Neuroscience<br />
        University of California, Berkeley<br />
        2195 Hearst Avenue, Room 275, MC# 3198<br />
        Berkeley, CA 94720-3198
      </address>
      <p class="part-of">
        Part of the <a href="https://neuroscience.berkeley.edu">Helen Wills Neuroscience Institute</a>
      </p>
    </div>
    <div class="links">
      <h2>Follow</h2>
      <ul>
        <li><a href="https://github.com/rctn">GitHub</a></li>
        <li><a href="https://twitter.com/Redwood_Neuro">X (Twitter)</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap legal">
    <span>© {new Date().getFullYear()} Redwood Center for Theoretical Neuroscience</span>
    <ul>
      <li><a href="https://dac.berkeley.edu/web-accessibility">Accessibility</a></li>
      <li><a href="https://ophd.berkeley.edu/policies-and-procedures/nondiscrimination-policy-statement">Nondiscrimination</a></li>
      <li><a href="https://redwood.berkeley.edu/privacy">Privacy</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--brand);
    color: #e9dfdf;
    padding-top: clamp(3rem, 6vw, 4.5rem);
    font-size: 0.9375rem;
  }
  .site-footer a { color: #fff; }
  h2 {
    color: #fff;
    font-size: var(--step-1);
    font-weight: 650;
    margin-bottom: 0.75rem;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1.3fr) minmax(0, 0.7fr);
    gap: 2.5rem;
  }
  .involved p { max-width: 46ch; }
  ul { list-style: none; margin: 0; padding: 0; }
  .programs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    margin-top: 0.75rem;
  }
  .links li + li { margin-top: 0.35rem; }
  address { font-style: normal; line-height: 1.6; }
  .part-of { margin-top: 1rem; }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 3rem;
    padding-block: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.18);
    font-size: var(--step--1);
    color: #c6b3b3;
  }
  .legal ul { display: flex; gap: 1.25rem; }
  .legal a { color: #c6b3b3; }

  @media (max-width: 860px) {
    .grid { grid-template-columns: minmax(0, 1fr); gap: 2rem; }
  }
</style>
