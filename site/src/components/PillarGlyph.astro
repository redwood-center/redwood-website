---
// One symbol per research pillar (ids from src/data/research.ts), used wherever the pillars are listed:
//   learning-mechanics: a ball settling at the bottom of a valley (gradient descent)
//   data-and-representations: scattered points lying along a curve (structure latent in data)
//   interpretability: a magnifying glass over a small network
//   dynamics: a spiral trajectory with an arrowhead, as in a phase portrait
//   collective-intelligence: five agents, each connected to every other (a swarm)
// Drawn for the Redwood Center website and dedicated to the public domain under CC0 1.0
// (https://creativecommons.org/publicdomain/zero/1.0/). Line art in currentColor, 24x24 grid, sized 1em by default.
interface Props {
  id: string;
  class?: string;
}
const { id, class: className } = Astro.props;
---

<svg
  class:list={['pillar-glyph', className]}
  viewBox="0 0 24 24"
  width="1em"
  height="1em"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {id === 'learning-mechanics' && (
    <>
      <path d="M3 6C7 19 17 19 21 6" />
      <circle cx="12" cy="12.4" r="2.6" fill="currentColor" stroke="none" />
    </>
  )}
  {id === 'data-and-representations' && (
    <>
      <path d="M3 19C8 13 15 13 21 5" stroke-width="1" opacity="0.55" />
      <g fill="currentColor" stroke="none">
        <circle cx="4.5" cy="16.5" r="1.5" />
        <circle cx="8" cy="15.5" r="1.5" />
        <circle cx="10.5" cy="12" r="1.5" />
        <circle cx="14" cy="13" r="1.5" />
        <circle cx="16.5" cy="9" r="1.5" />
        <circle cx="20" cy="8.5" r="1.5" />
      </g>
    </>
  )}
  {id === 'interpretability' && (
    <>
      <circle cx="10" cy="10" r="7" />
      <path d="M15 15l6 6" stroke-width="2.25" />
      <path d="M7.25 12.5L10 7.25L12.75 12.5Z" stroke-width="1" />
      <g fill="currentColor" stroke="none">
        <circle cx="10" cy="7.25" r="1.4" />
        <circle cx="7.25" cy="12.5" r="1.4" />
        <circle cx="12.75" cy="12.5" r="1.4" />
      </g>
    </>
  )}
  {id === 'dynamics' && (
    <>
      <path d="M12 12a1.5 1.5 0 0 1 3 0a3 3 0 0 1 -6 0a4.5 4.5 0 0 1 9 0a6 6 0 0 1 -12 0" />
      <path d="M3.8 14.2L6 12L8.2 14.2" />
    </>
  )}
  {id === 'collective-intelligence' && (
    <>
      <path
        d="M12 4.5L19.5 10L16.5 19L7.5 19L4.5 10ZM12 4.5L16.5 19L4.5 10L19.5 10L7.5 19Z"
        stroke-width="1"
        opacity="0.55"
      />
      <g fill="currentColor" stroke="none">
        <circle cx="12" cy="4.5" r="2" />
        <circle cx="19.5" cy="10" r="2" />
        <circle cx="16.5" cy="19" r="2" />
        <circle cx="7.5" cy="19" r="2" />
        <circle cx="4.5" cy="10" r="2" />
      </g>
    </>
  )}
</svg>
