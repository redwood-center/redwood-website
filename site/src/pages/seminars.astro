---
import Base from '../layouts/Base.astro';
import UpcomingSeminars from '../components/UpcomingSeminars.astro';
import { upcoming, past, searchable, seminarUrl, type Seminar } from '../lib/seminars';
import { formatShort } from '../lib/url';

const byYear = new Map<string, Seminar[]>();
for (const s of past) {
  const y = s.date.slice(0, 4);
  byYear.set(y, [...(byYear.get(y) ?? []), s]);
}
const years = [...byYear.keys()];
---

<Base title="Seminars" current="seminars">
  <section class="intro wrap">
    <h1>Seminars</h1>
    <p class="lead">
      Talks on neuroscience, machine learning and the theory of intelligence. Recordings of past talks
      are linked where available.
    </p>
  </section>

  <section class="section" aria-labelledby="upcoming-title">
    <div class="wrap">
      <h2 id="upcoming-title">Upcoming</h2>
      {upcoming.length > 0
        ? <UpcomingSeminars seminars={upcoming} showSummary />
        : <p class="none">Nothing on the books. Check back later!</p>}
    </div>
  </section>

  <script is:inline>
    // One year at a time when JS runs; without it, every year shows.
    document.documentElement.classList.add('years-js');
  </script>
  <section class="section section--wash" aria-labelledby="past-title">
    <div class="wrap past">
      <h2 id="past-title">Past seminars</h2>
      <div class="search" hidden>
        <label for="speaker-search">Search by speaker</label>
        <input id="speaker-search" type="search" placeholder="Speaker name" autocomplete="off" spellcheck="false" />
        <p class="status" aria-live="polite"></p>
      </div>
      <nav class="years" aria-label="Choose a year">
        {years.map((y, i) => <a href={`#y${y}`} aria-current={i === 0 ? 'true' : undefined}>{y}</a>)}
      </nav>
      {years.map((y, i) => (
        <div class:list={['year', { active: i === 0 }]} id={`y${y}`}>
          <h3>{y}</h3>
          <ul class="talks">
            {byYear.get(y)!.map((s) => (
              <li data-speaker={searchable(s.speaker)}>
                <time datetime={s.date}>{formatShort(s.date)}</time>
                <div>
                  <a class="title" href={seminarUrl(s)}>{s.title}</a>
                  <p class="who">{s.speaker}{s.affiliation && `, ${s.affiliation}`}</p>
                </div>
                {s.recording_url ? <a class="rec" href={s.recording_url}>Recording</a> : <span></span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</Base>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.years a')];
  const blocks = [...document.querySelectorAll<HTMLElement>('.year')];

  function show(id: string) {
    const target = blocks.find((b) => b.id === id) ?? blocks[0];
    blocks.forEach((b) => b.classList.toggle('active', b === target));
    links.forEach((a) => {
      if (a.hash === `#${target.id}`) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    });
  }

  links.forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      history.replaceState(null, '', a.hash); // shareable, without jumping the page
      show(a.hash.slice(1));
    }),
  );
  window.addEventListener('hashchange', () => show(location.hash.slice(1))); // back/forward, pasted links
  show(location.hash.slice(1));

  // Speaker search: while there's a query, every year's matching talks show (year links hidden).
  const past = document.querySelector<HTMLElement>('.past')!;
  const box = past.querySelector<HTMLElement>('.search')!;
  const input = box.querySelector<HTMLInputElement>('input')!;
  const status = box.querySelector<HTMLElement>('.status')!;
  const norm = (t: string) => t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  box.hidden = false;

  function search() {
    const words = norm(input.value).split(/\s+/).filter(Boolean);
    past.classList.toggle('searching', words.length > 0);
    let total = 0;
    for (const block of blocks) {
      let hits = 0;
      for (const li of block.querySelectorAll<HTMLElement>('li')) {
        const hit = words.every((w) => li.dataset.speaker!.includes(w));
        li.hidden = !hit;
        if (hit) hits++;
      }
      block.classList.toggle('has-hits', hits > 0);
      total += hits;
    }
    status.textContent = !words.length ? ''
      : total ? `${total} talk${total === 1 ? '' : 's'}` : `No speakers match “${input.value.trim()}”.`;
  }
  input.addEventListener('input', search);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { input.value = ''; search(); }
  });
  search(); // a query the browser restored on back
</script>

<style>
  .intro { padding-block: clamp(2.5rem, 6vw, 4.5rem) 0; }
  h1 { font-size: var(--step-4); font-weight: 700; letter-spacing: -0.025em; }
  .lead {
    font-family: var(--serif);
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 52ch;
    margin-top: 1rem;
  }
  h2 { font-size: var(--step-3); font-weight: 650; letter-spacing: -0.01em; margin-bottom: 1.75rem; }

  .none { font-family: var(--serif); font-size: var(--step-1); color: var(--slate); }

  .search { margin: -0.5rem 0 1.75rem; }
  .search label { display: block; font-weight: 600; font-size: 0.9375rem; margin-bottom: 0.4rem; }
  .search input {
    width: min(100%, 22rem);
    font: inherit;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: #fff;
    color: inherit;
  }
  .search input:focus-visible { outline: 3px solid var(--gold); outline-offset: 1px; border-color: var(--brand); }
  .status { margin-top: 0.5rem; color: var(--slate); font-size: 0.9375rem; min-height: 1.4em; }
  .searching .years { display: none; }
  :global(.years-js) .searching .year { display: none; }
  :global(.years-js) .searching .year.has-hits { display: block; }
  .searching .year.has-hits ~ .year.has-hits { margin-top: 2rem; }
  .talks li[hidden] { display: none; }

  .years {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    margin: -0.75rem 0 2rem;
    font-weight: 500;
  }
  .year { scroll-margin-top: 1.5rem; }
  .year + .year { margin-top: 2.5rem; }
  :global(.years-js) .year:not(.active) { display: none; }
  :global(.years-js) .year + .year { margin-top: 0; }
  .years a[aria-current='true'] {
    color: var(--brand);
    font-weight: 700;
    text-decoration-thickness: 3px;
    text-decoration-color: var(--gold);
  }
  .year h3 { font-size: var(--step-2); font-weight: 650; margin-bottom: 0.5rem; }

  .talks { list-style: none; margin: 0; padding: 0; }
  .talks li {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: baseline;
    padding-block: 0.8rem;
    border-top: 1px solid var(--line);
  }
  .talks time { color: var(--slate); font-size: 0.9375rem; }
  .title { font-weight: 550; text-decoration: none; }
  .title:hover { text-decoration: underline; }
  .who { color: var(--slate); font-size: 0.9375rem; margin-top: 0.15rem; }
  .rec { font-size: 0.875rem; font-weight: 500; white-space: nowrap; }

  @media (max-width: 640px) {
    .talks li { grid-template-columns: 4rem minmax(0, 1fr); }
    .rec { grid-column: 2; }
  }
</style>
