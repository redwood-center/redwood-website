---
// 3D PCA of how a base LLM (OLMo 3 7B) represents the 365 calendar dates, layer by layer. Each marker is one date
// (its final-token residual-stream vector for prompts like "Today is my birthday, 14 March", averaged over ~20
// prompts), colored around the hue wheel by day of year. The cloud turns slowly; drag to look around (it springs
// back on release), hover for the date. The slider picks the layer; play sweeps through depth on a loop. Each
// layer is drawn in its own PC basis (signs matched to the neighboring layer), so as the principal directions
// change through depth, the cloud rotates within the fixed PC1-3 axes.
//
// Data: dates-pca.json, the "14 March" prompt style from the widget on dkarkada.xyz
// (widget-src/residualstream/pca.py there). The caption is the component's children:
//   <DatesPCA>Caption text.</DatesPCA>
import './widget.css';
import dataUrl from './dates-pca.json?url';
---

<figure class="bw-figure">
  <div class="bw-card" data-dates-pca data-src={dataUrl}>
    <canvas
      role="img"
      aria-label="A slowly rotating 3D scatter plot of 365 points, one per calendar date, colored by time of year, with faint lines for the principal axes. Drag to rotate, hover to see dates; the slider below selects the layer."
    ></canvas>
    <div class="bw-tip" hidden></div>
    <div class="bw-controls">
      <button type="button" class="bw-play" aria-label="Play through the layers" aria-pressed="false"></button>
      <input class="bw-slider" type="range" min="1" max="32" step="1" value="17" aria-label="Layer" />
      <span class="bw-readout"></span>
    </div>
  </div>
  <figcaption><slot /></figcaption>
</figure>

<style>
  canvas { touch-action: none; cursor: grab; }
  canvas.grabbing { cursor: grabbing; }
</style>

<script>
  const SPIN = 0.12; // idle rotation speed (rad/s)
  const PITCH = 0.32; // resting camera elevation (rad)
  const DRAG_RAD = 0.008; // camera rotation per dragged pixel (rad)
  const SPRING_S = 0.15; // time constant of the snap back after a drag (s)
  const LAYER_RATE = 2.5; // layers per second while playing
  const EASE_S = 0.12; // time constant for slider-driven layer changes (s)
  const HOLD_S = 1.2; // pause on the last layer before looping
  const CAMERA = 4; // camera distance, in units of the cloud's radius
  const ASPECT = 0.72; // canvas height / width (the spin is horizontal, so extra height is wasted)
  const FILL = 0.56; // the cloud's radius as a fraction of the canvas height
  const AXIS_LEN = 1.1; // PC axis half-length, in units of the cloud's radius
  const HIT_PX = 14; // hover radius for the date tooltip
  const HUE_JAN = 250; // OKLCH hue of January 1; hue decreases through the year

  const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  const MONTH_DAYS = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
  const DATES = MONTHS.flatMap((m, i) => Array.from({ length: MONTH_DAYS[i] }, (_, d) => `${d + 1} ${m}`));
  // Blue in January, orange in July, red in September.
  const PALETTE = DATES.map((_, i) => `oklch(0.6 0.16 ${(HUE_JAN - (360 * i) / DATES.length + 360) % 360})`);
  const PLAY = '<svg viewBox="0 0 10 10"><path d="M2 1 L9 5 L2 9 Z"/></svg>';
  const PAUSE = '<svg viewBox="0 0 10 10"><path d="M2 1 H4 V9 H2 Z M6 1 H8 V9 H6 Z"/></svg>';

  type Data = { defaultLayer: number; evr: number[][]; coords: { scale: number; shape: number[]; data: string } };

  function unpack({ scale, data }: Data['coords']) {
    const bytes = Uint8Array.from(atob(data), (c) => c.charCodeAt(0));
    return Float32Array.from(new Int8Array(bytes.buffer), (v) => (v / 127) * scale);
  }

  function setup(root: HTMLElement, data: Data) {
    const canvas = root.querySelector('canvas')!;
    const tip = root.querySelector<HTMLElement>('.bw-tip')!;
    const button = root.querySelector<HTMLButtonElement>('.bw-play')!;
    const slider = root.querySelector<HTMLInputElement>('.bw-slider')!;
    const readout = root.querySelector<HTMLElement>('.bw-readout')!;
    const css = getComputedStyle(document.documentElement);
    const colors = { slate: css.getPropertyValue('--slate').trim(), text: css.getPropertyValue('--text').trim() };
    const font = css.getPropertyValue('--sans').trim() || 'sans-serif';

    const [nLayers, nDates] = data.coords.shape;
    const coords = unpack(data.coords);
    // Per-layer cloud radius (98th percentile, so a few outlying dates don't shrink the rest).
    const radius = Array.from({ length: nLayers }, (_, l) => {
      const r = Array.from({ length: nDates }, (_, i) => Math.hypot(...coords.subarray((l * nDates + i) * 3, (l * nDates + i) * 3 + 3))).sort((a, b) => a - b);
      return r[Math.floor(0.98 * (nDates - 1))];
    });
    slider.max = String(nLayers);

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let ctx: CanvasRenderingContext2D | null = null;
    let W = 0, H = 0;
    let playing = false, hold = 0;
    let layerPos = data.defaultLayer, layerTarget = data.defaultLayer;
    let yaw = 0, dragYaw = 0, dragPitch = 0;
    let drag: { x: number; y: number; yaw: number; pitch: number; moved: boolean } | null = null;
    let pointer: [number, number] | null = null;
    let visible = false, last: number | null = null, raf: number | null = null;

    function resize() {
      const dpr = window.devicePixelRatio || 1;
      W = canvas.clientWidth;
      if (!W) return;
      H = Math.round(W * ASPECT);
      canvas.style.height = `${H}px`;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx = canvas.getContext('2d')!;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      draw();
    }

    function setPlaying(p: boolean) {
      playing = p;
      hold = 0;
      button.innerHTML = playing ? PAUSE : PLAY;
      button.setAttribute('aria-label', playing ? 'Pause' : 'Play through the layers');
      button.setAttribute('aria-pressed', String(playing));
      if (!playing) layerPos = layerTarget = Math.round(layerPos);
      syncControls();
    }

    function syncControls() {
      const l = Math.round(layerPos);
      slider.value = String(l);
      readout.textContent = `layer ${l} of ${nLayers}`;
    }

    // Screen positions of every date (and the PC axis tips) at the current layer and camera angle.
    const px = new Float32Array(nDates), py = new Float32Array(nDates), pz = new Float32Array(nDates);
    const order = Array.from({ length: nDates }, (_, i) => i);
    let axes: [number[], number[]][] = [];
    function project() {
      const x = Math.min(Math.max(layerPos - 1, 0), nLayers - 1);
      const i0 = Math.floor(x), i1 = Math.min(i0 + 1, nLayers - 1), f = x - i0;
      const mix = (get: (l: number) => number) => get(i0) * (1 - f) + get(i1) * f;
      const a = yaw + dragYaw, b = PITCH + dragPitch;
      const [ca, sa, cb, sb] = [Math.cos(a), Math.sin(a), Math.cos(b), Math.sin(b)];
      const R = mix((l) => radius[l]);
      const s = ((H * FILL) / R) * ((CAMERA - 1) / CAMERA);
      // PC1 -> right, PC2 -> up, PC3 -> toward the viewer; yaw about the vertical, then pitch.
      const toScreen = ([u, v, w]: number[]) => {
        const x1 = ca * u + sa * w, z1 = -sa * u + ca * w;
        const y2 = cb * v - sb * z1, z2 = sb * v + cb * z1;
        const persp = CAMERA / Math.max(1, CAMERA - z2 / R);
        return [W / 2 + s * persp * x1, H / 2 - s * persp * y2, z2 / R];
      };
      for (let i = 0; i < nDates; i++) {
        [px[i], py[i], pz[i]] = toScreen([0, 1, 2].map((k) => mix((l) => coords[(l * nDates + i) * 3 + k])));
      }
      order.sort((p, q) => pz[p] - pz[q]);
      axes = [0, 1, 2].map((k) => {
        const dir = [0, 1, 2].map((j) => (j === k ? AXIS_LEN * R : 0));
        return [toScreen(dir), toScreen(dir.map((c) => -c))];
      });
    }

    function hovered() {
      if (!pointer || drag) return -1;
      let best = -1, bestD = HIT_PX;
      // Front-most first, so overlapping markers resolve to the visible one.
      for (let k = nDates - 1; k >= 0; k--) {
        const i = order[k];
        const d = Math.hypot(px[i] - pointer[0], py[i] - pointer[1]);
        if (d < bestD - 2) { best = i; bestD = d; }
      }
      return best;
    }

    function draw() {
      if (!ctx || !W) return;
      project();
      ctx.clearRect(0, 0, W, H);
      const r = Math.max(2.2, W / 150);
      const fs = Math.round(Math.max(11, W / 42));

      // PC axes: faint lines through the centroid, labeled at the positive end.
      ctx.strokeStyle = colors.slate;
      ctx.fillStyle = colors.slate;
      ctx.lineWidth = 1;
      ctx.font = `500 ${Math.round(fs * 0.85)}px ${font}`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      axes.forEach(([[x0, y0], [x1, y1]], k) => {
        ctx!.globalAlpha = 0.3;
        ctx!.beginPath(); ctx!.moveTo(x0, y0); ctx!.lineTo(x1, y1); ctx!.stroke();
        const len = Math.hypot(x0 - x1, y0 - y1) || 1;
        ctx!.globalAlpha = 0.7;
        const lx = Math.max(1.5 * fs, Math.min(W - 1.5 * fs, x0 + ((x0 - x1) / len) * fs));
        const ly = Math.max(1.8 * fs, Math.min(H - 0.7 * fs, y0 + ((y0 - y1) / len) * fs));
        ctx!.fillText(`PC${k + 1}`, lx, ly);
      });
      for (const i of order) {
        const depth = Math.max(0, Math.min(1, (pz[i] + 1) / 2)); // 0 at the back, 1 at the front
        ctx.globalAlpha = 0.45 + 0.5 * depth;
        ctx.fillStyle = PALETTE[i];
        ctx.beginPath(); ctx.arc(px[i], py[i], r * (0.8 + 0.4 * depth), 0, 2 * Math.PI); ctx.fill();
      }
      ctx.globalAlpha = 1;

      const h = hovered();
      if (h >= 0) {
        ctx.strokeStyle = colors.text;
        ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.arc(px[h], py[h], r * 2.2, 0, 2 * Math.PI); ctx.stroke();
        tip.hidden = false;
        tip.style.left = `${px[h] + canvas.offsetLeft}px`;
        tip.style.top = `${py[h] + canvas.offsetTop}px`;
        tip.textContent = DATES[h];
      } else tip.hidden = true;

      // Month key: initials in each month's color. Variance explained, top right.
      ctx.font = `600 ${fs}px ${font}`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'top';
      let day = 0;
      MONTHS.forEach((m, k) => {
        ctx!.fillStyle = PALETTE[day + 14];
        ctx!.fillText(m[0], fs * (0.5 + 1.05 * k), 0);
        day += MONTH_DAYS[k];
      });
      ctx.font = `${fs}px ${font}`;
      ctx.fillStyle = colors.slate;
      ctx.textAlign = 'right';
      const l = Math.round(layerPos);
      ctx.fillText(`PCs 1–3: ${Math.round(100 * data.evr[l - 1].reduce((a, b) => a + b, 0))}% of variance`, W, 0);
    }

    function step(dt: number) {
      if (!drag) {
        yaw += (reduceMotion ? 0 : SPIN) * dt;
        const k = Math.exp(-dt / SPRING_S);
        dragYaw *= k;
        dragPitch *= k;
      }
      const before = Math.round(layerPos);
      if (playing) {
        if (layerPos >= nLayers) {
          hold += dt;
          if (hold >= HOLD_S) { layerPos = 1; hold = 0; }
        } else layerPos = Math.min(nLayers, layerPos + LAYER_RATE * dt);
      } else {
        layerPos = layerTarget + (layerPos - layerTarget) * Math.exp(-dt / EASE_S);
        if (Math.abs(layerPos - layerTarget) < 1e-3) layerPos = layerTarget;
      }
      if (Math.round(layerPos) !== before) syncControls();
    }

    function frame(now: number) {
      raf = null;
      if (!canvas.isConnected) return;
      if (last !== null) step(Math.min(0.1, (now - last) / 1000));
      last = now;
      draw();
      schedule();
    }

    function schedule() {
      if (visible && raf === null) raf = requestAnimationFrame(frame);
      if (!visible) last = null;
    }

    button.addEventListener('click', () => setPlaying(!playing));
    slider.addEventListener('input', () => {
      layerTarget = Number(slider.value);
      if (playing) { layerPos = layerTarget; hold = 0; }
      syncControls();
      draw();
    });

    // Drag rotates the camera; release lets it spring back to the idle orbit.
    const local = (e: PointerEvent): [number, number] => {
      const rect = canvas.getBoundingClientRect();
      return [e.clientX - rect.left, e.clientY - rect.top];
    };
    canvas.addEventListener('pointerdown', (e) => {
      pointer = local(e);
      drag = { x: e.clientX, y: e.clientY, yaw: dragYaw, pitch: dragPitch, moved: false };
      canvas.setPointerCapture(e.pointerId);
      canvas.classList.add('grabbing');
      e.preventDefault();
    });
    canvas.addEventListener('pointermove', (e) => {
      pointer = local(e);
      if (!drag) return;
      const dx = e.clientX - drag.x, dy = e.clientY - drag.y;
      if (Math.hypot(dx, dy) > 3) drag.moved = true;
      dragYaw = drag.yaw + dx * DRAG_RAD;
      dragPitch = Math.max(-1.4 - PITCH, Math.min(1.4 - PITCH, drag.pitch + dy * DRAG_RAD));
    });
    const release = (e: PointerEvent) => {
      // A tap (no drag) on touch keeps the tooltip at the tapped point.
      if (drag && !drag.moved && e.pointerType !== 'mouse') pointer = local(e);
      else if (e.pointerType !== 'mouse') pointer = null;
      drag = null;
      canvas.classList.remove('grabbing');
    };
    canvas.addEventListener('pointerup', release);
    canvas.addEventListener('pointercancel', release);
    canvas.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse' && !drag) pointer = null; });

    setPlaying(false);
    new ResizeObserver(resize).observe(canvas);
    // Canvas text doesn't reflow when a web font arrives, so redraw once the font has loaded.
    document.fonts?.load(`1em ${font}`).then(() => draw());
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; schedule(); }).observe(canvas);
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-dates-pca]')) {
    fetch(root.dataset.src!).then((r) => r.json()).then((data) => setup(root, data));
  }
</script>
